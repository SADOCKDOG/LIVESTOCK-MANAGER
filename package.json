{
  "name": "livestock-manager-premium",
  "version": "4.10.8",
  "private": true,
  "description": "Sistema profesional de gestión ganadera con comercialización masiva, trazabilidad industrial, Informes Premium y Gestión por Especies v4.0.0.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SADOCKDOG/LIVESTOCK-MANAGER.git"
  },
  "scripts": {
    "build": "powershell -NoProfile -Command \"if (-not (Test-Path www)) { New-Item -ItemType Directory -Path www | Out-Null }; Copy-Item -Path index.html, manifest.webmanifest, sw.js -Destination www -Force; foreach ($d in 'css','js','icons','manual','tests') { Copy-Item -Path $d -Destination www -Recurse -Force } \"",
    "cap:add": "npx cap add android",
    "cap:open": "npx cap open android",
    "postinstall": "patch-package",
    "prebuild:pago": "powershell -NoProfile -Command \"Copy-Item -Path js/mode-config-con-pago.js -Destination js/mode-config.js -Force\"",
    "prebuild:demo": "powershell -NoProfile -Command \"Copy-Item -Path js/mode-config-sin-pago.js -Destination js/mode-config.js -Force\"",
    "build:pago": "npm run prebuild:pago && npm run build",
    "build:demo": "npm run prebuild:demo && npm run build",
    "cap:sync:pago": "set FREE_MODE=true&& npm run build:pago && npx cap sync android",
    "cap:sync:demo": "set FREE_MODE=false&& npm run build:demo && npx cap sync android",
    "build:free": "npm run build:pago",
    "build:premium": "npm run build:demo",
    "cap:sync:free": "npm run cap:sync:pago",
    "cap:sync:premium": "npm run cap:sync:demo",
    "cap:sync": "npm run cap:sync:demo"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@playwright/test": "^1.62.1",
    "chrome-remote-interface": "^0.34.0",
    "markdown-it": "^14.3.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "puppeteer": "^25.5.0",
    "typescript": "~5.9.0",
    "pdfjs-dist": "^4",
    "pdf-lib": "^1.17.1"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capawesome/capacitor-file-picker": "^7.2.0",
    "cordova-plugin-purchase": "^13.18.0"
  },
  "overrides": {
    "minimatch": "3.1.4",
    "uuid": "11.1.1",
    "protobufjs": "7.6.3",
    "brace-expansion": "1.1.18",
    "tar": "7.5.22"
  },
  "main": "sw.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/SADOCKDOG/LIVESTOCK-MANAGER/issues"
  },
  "homepage": "https://github.com/SADOCKDOG/LIVESTOCK-MANAGER#readme"
}
